# Backend por defecto en desarrollo. Sin esta variable, Vite deja
# import.meta.env.VITE_API_BASE_URL como undefined y las URLs quedan
# construidas como "/undefined/api/v1/...".
# Para apuntar a otro backend (p. ej. la VM institucional), crear .env
# —que está en .gitignore— con el valor deseado.
VITE_API_BASE_URL=http://localhost:8000
